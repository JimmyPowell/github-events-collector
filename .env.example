# Comma-separated GitHub Personal Access Tokens (strongly recommended: 5000 req/hr per token)
# Without a token, the collector runs in anonymous mode (60 req/hr).
GITHUB_TOKENS=

# Directory to store hourly .jsonl and compressed .jsonl.gz archives
DATA_DIR=data

# Polling interval in seconds (default: 1.0s with token, 60.0s anonymous)
# With 1 token (5000 req/hr), 0.8~1.0s is safe and close to GH Archive's 0.75s cadence.
POLL_INTERVAL_SECONDS=1.0

# Events per request (GitHub max is 100)
PER_PAGE=100

# SHA1-hash email local parts (like GH Archive)
OBFUSCATE_EMAIL=true

# Optional: comma-separated filter, e.g. WatchEvent,IssuesEvent,PullRequestEvent
# Leave empty to collect ALL public events.
EVENT_TYPES=

# Disk protection: auto-delete .jsonl.gz older than N days (0 disables)
MAX_RETENTION_DAYS=7

# Disk protection: auto-delete oldest .jsonl.gz when disk usage exceeds N% (0 disables)
MAX_DISK_USAGE_PERCENT=80

LOG_LEVEL=INFO
